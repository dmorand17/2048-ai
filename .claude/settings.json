{
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "0",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "",
    "CLAUDE_CODE_SUBAGENT_MODEL": ""
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat >> \"$CLAUDE_PROJECT_DIR\"/.claude/hooks-stop.jsonl"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat >> \"$CLAUDE_PROJECT_DIR\"/.claude/hooks-skill.jsonl"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun run:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "mcp__gh__*",
      "Read",
      "Write(src/**)",
      "Write(infra/**)",
      "Write(docs/**)",
      "Edit(src/**)",
      "Edit(index.html)",
      "Edit(infra/**)"
    ],
    "deny": [],
    "ask": []
  }
}
